  "能天使": {
    "中文": {
      "登录": [{"url": "voice_cn/char_103_angel/cn_001.wav", "text": "老板，安排点差事给我们吧~"}],
      "交谈": [{"url": "voice_cn/char_103_angel/cn_002.wav", "text": "老板，不办个派对吗？来点嘻哈，再来点烤苹果派~完美的人生可是不能停止聚会的！No party，No life！"}, {"url": "voice_cn/char_103_angel/cn_003.wav", "text": "子弹上膛，准备万全★老板，今天送点什么呀！"}],
      "信赖": [{"url": "voice_cn/char_103_angel/cn_007.wav", "text": "德克萨斯那家伙能活得这么潇洒，可多亏有我罩着她，这不是明摆着的事嘛~"}, {"url": "voice_cn/char_103_angel/cn_008.wav", "text": "如果您见到一名长着漆黑的角，散发着不祥气息的天使，请一定替我转告她：我从来没有忘记过她。"}],
      "闲置": [{"url": "voice_cn/char_103_angel/cn_010.wav", "text": "......主啊，这个人也是我们要拯救的吗？"}],
