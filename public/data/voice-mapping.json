  "星熊": {
    "中文": {
      "登录": [{"url": "voice_cn/char_136_hsguma/cn_001.wav", "text": "博士请放心，有我在您就是安全的。"}],
      "交谈": [{"url": "voice_cn/char_136_hsguma/cn_002.wav", "text": "最近来了很多新人。然而新面孔越多，您越要多加注意。"}, {"url": "voice_cn/char_136_hsguma/cn_003.wav", "text": "无论发生什么情况，请别忘了紧急通讯频段，我会立刻前来处理。"}],
      "信赖": [{"url": "voice_cn/char_136_hsguma/cn_007.wav", "text": "这面盾叫做般若，是我从故乡带来的，它的父亲和家父是旧识。"}, {"url": "voice_cn/char_136_hsguma/cn_008.wav", "text": "这面般若沾上了龙门各个帮派的血。本以为会有很多人记恨我，不知道怎么回事，原本蔑视我的人都变得对我毕恭毕敬了。"}],
      "闲置": [{"url": "voice_cn/char_136_hsguma/cn_010.wav", "text": "嗯？没什么，我就是在这里守着你而已。"}],
      "精英化": [{"url": "voice_cn/char_136_hsguma/cn_013.wav", "text": ""}, {"url": "voice_cn/char_136_hsguma/cn_014.wav", "text": ""}],
      "编入": [{"url": "voice_cn/char_136_hsguma/cn_017.wav", "text": ""}],
      "行动开始": [{"url": "voice_cn/char_136_hsguma/cn_020.wav", "text": ""}],
      "选中": [{"url": "voice_cn/char_136_hsguma/cn_021.wav", "text": ""}],
      "部署": [{"url": "voice_cn/char_136_hsguma/cn_023.wav", "text": ""}],
