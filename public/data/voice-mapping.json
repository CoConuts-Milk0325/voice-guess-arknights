  "德克萨斯": {
    "中文": {
      "登录": [{"url": "voice_cn/char_102_texas/cn_001.wav", "text": "我接下来的任务是保护博士你的安全。"}],
      "交谈": [{"url": "voice_cn/char_102_texas/cn_002.wav", "text": "我的话不多？实际上，我对大多数事情都没什么感想。"}, {"url": "voice_cn/char_102_texas/cn_003.wav", "text": "我们的工作是搬运生命和死亡。"}],
      "信赖": [{"url": "voice_cn/char_102_texas/cn_007.wav", "text": "红色的狼，务必要小心。她不坏，但.....她和我们不一样。"}, {"url": "voice_cn/char_102_texas/cn_008.wav", "text": "无论怎么逃，我的过去总有一天会追上我。"}],
