  "闪灵": {
    "中文": {
      "登录": [{"url": "voice_cn/char_147_shining/cn_001.wav", "text": "你好，博士......没有什么，想聊的话题吗？"}],
      "交谈": [{"url": "voice_cn/char_147_shining/cn_002.wav", "text": "你的脸色很糟糕。胸口也很痛？不要逞强，请马上休息......别害怕，我就在你身边，一定会没事的......"}, {"url": "voice_cn/char_147_shining/cn_003.wav", "text": "我的医疗法术似乎在什么地方见过......？那是错觉，嗯，一定是......"}],
      "信赖": [{"url": "voice_cn/char_147_shining/cn_007.wav", "text": "我和临光？是啊，她是我旅途的伙伴，也是值得托付生命的人。"}, {"url": "voice_cn/char_147_shining/cn_008.wav", "text": "为拯救痛苦的人们不惜牺牲自己的一切——临光那个孩子，就是这样一个人。"}],
      "闲置": [{"url": "voice_cn/char_147_shining/cn_010.wav", "text": "......这份寂静， 让我想起了身在故乡时的岁月。"}],
      "精英化": [{"url": "voice_cn/char_147_shining/cn_013.wav", "text": ""}, {"url": "voice_cn/char_147_shining/cn_014.wav", "text": ""}],
