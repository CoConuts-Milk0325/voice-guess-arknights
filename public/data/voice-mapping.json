  "夜刀": {
    "中文": {
      "登录": [{"url": "voice_cn/char_502_nblade/cn_001.wav", "text": "博士，只要告诉我今天的工作内容就行了。"}],
      "交谈": [{"url": "voice_cn/char_502_nblade/cn_002.wav", "text": "即使在工作之外的时间里，我也会注意您的状况。"}],
      "信赖": [{"url": "voice_cn/char_502_nblade/cn_007.wav", "text": "虽然我们能做到的事有限，但我还是希望能帮忙减轻您的负担。"}, {"url": "voice_cn/char_502_nblade/cn_008.wav", "text": "每当我看到其他小队的干员们的活跃表现，总是会特别羡慕......"}],
      "闲置": [{"url": "voice_cn/char_502_nblade/cn_010.wav", "text": "博士，让我今后也一直守护着您吧。"}],
