  "陈": {
    "中文": {
      "登录": [{"url": "voice_cn/char_010_chen/cn_001.wav", "text": "博士，现在起由我担任你的护卫。"}],
      "交谈": [{"url": "voice_cn/char_010_chen/cn_002.wav", "text": "我一直觉得你们罗德岛很可疑，现在也一样。"}, {"url": "voice_cn/char_010_chen/cn_003.wav", "text": "你怎么还在盯着我看？你的工作呢？"}, {"url": "voice_cn/char_010_chen/cn_004.wav", "text": "哼。"}],
      "信赖": [{"url": "voice_cn/char_010_chen/cn_007.wav", "text": "也许有一天我会得到那个人的认可，在那之前......"}, {"url": "voice_cn/char_010_chen/cn_008.wav", "text": "阿米娅深深信赖着你。看着你们两人站在一起，我偶尔也会觉得，如果我身边，也能有这样一个人......"}, {"url": "voice_cn/char_010_chen/cn_009.wav", "text": "我......我从没试过去毫无保留地相信一个人，即使是那个人也......"}],
      "闲置": [{"url": "voice_cn/char_010_chen/cn_010.wav", "text": "博士？睡着了？哼，真没紧张感。"}],
      "精英化": [{"url": "voice_cn/char_010_chen/cn_013.wav", "text": ""}, {"url": "voice_cn/char_010_chen/cn_014.wav", "text": ""}],
