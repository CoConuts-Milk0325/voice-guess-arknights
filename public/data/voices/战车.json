{
  "中文": {
    "登录": [
      {
        "url": "voice/char_459_tachak/cn_001.wav",
        "text": "你这里并不需要战术人员......我知道了，你是请我来聊天的。"
      }
    ],
    "交谈": [
      {
        "url": "voice/char_459_tachak/cn_002.wav",
        "text": "我热爱我的国家，以及它所给我带来的一切——无论那是好是坏。"
      },
      {
        "url": "voice/char_459_tachak/cn_003.wav",
        "text": "你还没见过我妹妹吧，看，照片上穿白大褂的就是她，旁边是她家的孩子。"
      },
      {
        "url": "voice/char_459_tachak/cn_004.wav",
        "text": "好好活着，这样你才能当大家的领袖，千万别让爱你的人只能去墓地见你一面，明白吗？"
      }
    ],
    "晋升交谈": [
      {
        "url": "voice/char_459_tachak/cn_005.wav",
        "text": "我不希望我的孩子追随我的脚步，成为军人要吃的苦不是他们能够接受的。"
      },
      {
        "url": "voice/char_459_tachak/cn_006.wav",
        "text": "倾泻火力简单而又有效，我们国家的人就喜欢这种方法。"
      }
    ],
    "信赖": [
      {
        "url": "voice/char_459_tachak/cn_007.wav",
        "text": "我喜欢你的思考模式。"
      },
      {
        "url": "voice/char_459_tachak/cn_008.wav",
        "text": "我个人比较喜欢敌人自己冲过来找死，你呢？"
      },
      {
        "url": "voice/char_459_tachak/cn_009.wav",
        "text": "放松点亲爱的，等完事了我请你喝伏特加。"
      }
    ],
    "闲置": [
      {
        "url": "voice/char_459_tachak/cn_010.wav",
        "text": "你很无聊吗，为什么不保养你的武器？"
      }
    ],
    "报到": [
      {
        "url": "voice/char_459_tachak/cn_011.wav",
        "text": "彩虹小队成员，代号战车。我准备好了，你将把我派去何方？"
      }
    ],
    "作战记录": [
      {
        "url": "voice/char_459_tachak/cn_012.wav",
        "text": "我们先是从中学习，再来就可以智胜他们。"
      }
    ],
    "精英化1": [
      {
        "url": "voice/char_459_tachak/cn_013.wav",
        "text": "很好。"
      }
    ],
    "精英化2": [
      {
        "url": "voice/char_459_tachak/cn_014.wav",
        "text": "他们当时说我要死了，他们错了，我重生了。"
      }
    ],
    "编入": [
      {
        "url": "voice/char_459_tachak/cn_017.wav",
        "text": "对，对，我懂的。"
      }
    ],
    "任命队长": [
      {
        "url": "voice/char_459_tachak/cn_018.wav",
        "text": "千万别逞英雄，不会有用的。"
      }
    ],
    "行动出发": [
      {
        "url": "voice/char_459_tachak/cn_019.wav",
        "text": "跟着我就对了！"
      }
    ],
    "行动开始": [
      {
        "url": "voice/char_459_tachak/cn_020.wav",
        "text": "发现敌方。"
      }
    ],
    "选中": [
      {
        "url": "voice/char_459_tachak/cn_021.wav",
        "text": "太好了，宝贝。"
      },
      {
        "url": "voice/char_459_tachak/cn_022.wav",
        "text": "让我们直接开工吧。"
      }
    ],
    "部署": [
      {
        "url": "voice/char_459_tachak/cn_023.wav",
        "text": "各位，有我在你们真是太幸运了。"
      },
      {
        "url": "voice/char_459_tachak/cn_024.wav",
        "text": "别担心！有战车在呢！"
      }
    ],
    "技能": [
      {
        "url": "voice/char_459_tachak/cn_025.wav",
        "text": "快来找战车吧，宝贝。"
      },
      {
        "url": "voice/char_459_tachak/cn_026.wav",
        "text": "可以大开杀戒了。"
      },
      {
        "url": "voice/char_459_tachak/cn_027.wav",
        "text": "部署好火力区域了。"
      },
      {
        "url": "voice/char_459_tachak/cn_028.wav",
        "text": "让他们自投罗网吧！"
      }
    ],
    "高难胜利": [
      {
        "url": "voice/char_459_tachak/cn_029.wav",
        "text": "还真是没预料到。"
      }
    ],
    "3星胜利": [
      {
        "url": "voice/char_459_tachak/cn_030.wav",
        "text": "我什么场面没见过。"
      }
    ],
    "非3星胜利": [
      {
        "url": "voice/char_459_tachak/cn_031.wav",
        "text": "朋友，我们还没脱离险境呢。"
      }
    ],
    "失败": [
      {
        "url": "voice/char_459_tachak/cn_032.wav",
        "text": "保护博士！"
      }
    ],
    "进驻": [
      {
        "url": "voice/char_459_tachak/cn_033.wav",
        "text": "我没意见。"
      }
    ],
    "戳一下": [
      {
        "url": "voice/char_459_tachak/cn_034.wav",
        "text": "当心点，同志。"
      }
    ],
    "信赖触摸": [
      {
        "url": "voice/char_459_tachak/cn_036.wav",
        "text": "如果你有需要，就叫我来帮忙。"
      }
    ],
    "标题": [
      {
        "url": "voice/char_459_tachak/cn_037.wav",
        "text": "明日方舟。"
      }
    ],
    "问候": [
      {
        "url": "voice/char_459_tachak/cn_042.wav",
        "text": "有事？"
      }
    ]
  },
