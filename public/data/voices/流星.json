{"中文":{"登录":[{"url":"voice_cn/char_126_shotst/cn_001.wav","text":"好怀念的气息啊。这里是......？"}],"交谈":[{"url":"voice_cn/char_126_shotst/cn_002.wav","text":"来自卡西米尔的风，您感受到了吗？"},{"url":"voice_cn/char_126_shotst/cn_003.wav","text":"罗德岛和我待过的地方不一样，这里没有可以点起篝火的地方，真遗憾。不知道在甲板上能不能行，我想给大家创造一个近距离说话聊天的场所。"},{"url":"voice_cn/char_126_shotst/cn_004.wav","text":"这个任务登记系统......？呃，要怎么操作呢？我对电子设备真的不怎么在行......"}],"晋升交谈":[{"url":"voice_cn/char_126_shotst/cn_005.wav","text":"最近罗德岛增加了许多新面孔啊。为了让他们更顺利地融入罗德岛，必要的时候我会去帮助他们的。"},{"url":"voice_cn/char_126_shotst/cn_006.wav","text":"那位卡西米尔骑士......嗯，我没认错，我以前就认识她，那时候她还是个喜欢读书的内向女孩呢。变化可真大啊。"}],"信赖":[{"url":"voice_cn/char_126_shotst/cn_007.wav","text":"嘘——看，我发现了什么，这儿有一位落单的博士，我们可以尝试捕捉他！吓到您了吗？呵呵~"},{"url":"voice_cn/char_126_shotst/cn_008.wav","text":"偶尔的，我会想起在森林中的故乡时度过的日子。每年都有各种各样的竞赛可以参加，真怀念啊。不知道，我的故乡现在又变成什么样了呢。"},{"url":"voice_cn/char_126_shotst/cn_009.wav","text":"博士的背后，无论什么时候都可以放心地交给我。"}],"闲置":[{"url":"voice_cn/char_126_shotst/cn_010.wav","text":"博士也会这样毫无防备地睡着啊，呵呵。"}],"报到":[{"url":"voice_cn/char_126_shotst/cn_011.wav","text":"你好，我是流星，来自森林的弓箭手。您需要擅长远程援护的干员吗？"}],"作战记录":[{"url":"voice_cn/char_126_shotst/cn_012.wav","text":"弓术的练习，哪怕一天也不能松懈呀。"}],"精英化1":[{"url":"voice_cn/char_126_shotst/cn_013.wav","text":"我很荣幸获得这次晋升机会。"}],"精英化2":[{"url":"voice_cn/char_126_shotst/cn_014.wav","text":"谢谢博士的认可。今后就让我继续为博士贡献自己的力量吧。"}],"编入":[{"url":"voice_cn/char_126_shotst/cn_017.wav","text":"远程援护就交给我吧。"}],"任命队长":[{"url":"voice_cn/char_126_shotst/cn_018.wav","text":"我会照顾好大家的。"}],"行动出发":[{"url":"voice_cn/char_126_shotst/cn_019.wav","text":"伙伴们，出发。"}],"行动开始":[{"url":"voice_cn/char_126_shotst/cn_020.wav","text":"展示我们力量的时候到了。"}],"选中":[{"url":"voice_cn/char_126_shotst/cn_021.wav","text":"请您下令。"},{"url":"voice_cn/char_126_shotst/cn_022.wav","text":"我已等候多时。"}],"部署":[{"url":"voice_cn/char_126_shotst/cn_023.wav","text":"风吹向了正确的地方。"},{"url":"voice_cn/char_126_shotst/cn_024.wav","text":"我会保持警戒。"}],"技能":[{"url":"voice_cn/char_126_shotst/cn_025.wav","text":"有破绽！"},{"url":"voice_cn/char_126_shotst/cn_026.wav","text":"风！"},{"url":"voice_cn/char_126_shotst/cn_027.wav","text":"就是这一箭！"},{"url":"voice_cn/char_126_shotst/cn_028.wav","text":"致命一击。"}],"高难胜利":[{"url":"voice_cn/char_126_shotst/cn_029.wav","text":"不管是什么样的难关，只要我们齐心协力，就一定能克服过去。"}],"3星胜利":[{"url":"voice_cn/char_126_shotst/cn_030.wav","text":"干的漂亮，大家都是最棒的。"}],"非3星胜利":[{"url":"voice_cn/char_126_shotst/cn_031.wav","text":"请伤者留在原地，别乱动，我马上就去帮你。"}],"失败":[{"url":"voice_cn/char_126_shotst/cn_032.wav","text":"抱歉，不应该是这样的......"}],"进驻":[{"url":"voice_cn/char_126_shotst/cn_033.wav","text":"我还是不太习惯这么狭小的房间啊。"}],"戳一下":[{"url":"voice_cn/char_126_shotst/cn_034.wav","text":"哎呀？有什么事吗？"}],"信赖触摸":[{"url":"voice_cn/char_126_shotst/cn_036.wav","text":"和博士在一起的时光，就像沐浴在春天的阳光里一样温暖，很舒服。"}],"标题":[{"url":"voice_cn/char_126_shotst/cn_037.wav","text":"明日方舟。"}],"新年":[{"url":"voice_cn/char_126_shotst/cn_038.wav","text":"又是一年了，森林是不是还和我当初离去时一样呢？虽然我仍旧有些不习惯现代生活，人们对矿石病的恐惧也似乎并没有减少，但是，新年的到来让这片大地重新焕发生机，万事都还是有希望的吧。"}],"问候":[{"url":"voice_cn/char_126_shotst/cn_042.wav","text":"博士，您好。"}]},"日文":{"登录":[{"url":"voice/char_126_shotst/cn_001.wav","text":"好怀念的气息啊。这里是......？"}],"交谈":[{"url":"voice/char_126_shotst/cn_002.wav","text":"来自卡西米尔的风，您感受到了吗？"},{"url":"voice/char_126_shotst/cn_003.wav","text":"罗德岛和我待过的地方不一样，这里没有可以点起篝火的地方，真遗憾。不知道在甲板上能不能行，我想给大家创造一个近距离说话聊天的场所。"},{"url":"voice/char_126_shotst/cn_004.wav","text":"这个任务登记系统......？呃，要怎么操作呢？我对电子设备真的不怎么在行......"}],"晋升交谈":[{"url":"voice/char_126_shotst/cn_005.wav","text":"最近罗德岛增加了许多新面孔啊。为了让他们更顺利地融入罗德岛，必要的时候我会去帮助他们的。"},{"url":"voice/char_126_shotst/cn_006.wav","text":"那位卡西米尔骑士......嗯，我没认错，我以前就认识她，那时候她还是个喜欢读书的内向女孩呢。变化可真大啊。"}],"信赖":[{"url":"voice/char_126_shotst/cn_007.wav","text":"嘘——看，我发现了什么，这儿有一位落单的博士，我们可以尝试捕捉他！吓到您了吗？呵呵~"},{"url":"voice/char_126_shotst/cn_008.wav","text":"偶尔的，我会想起在森林中的故乡时度过的日子。每年都有各种各样的竞赛可以参加，真怀念啊。不知道，我的故乡现在又变成什么样了呢。"},{"url":"voice/char_126_shotst/cn_009.wav","text":"博士的背后，无论什么时候都可以放心地交给我。"}],"闲置":[{"url":"voice/char_126_shotst/cn_010.wav","text":"博士也会这样毫无防备地睡着啊，呵呵。"}],"报到":[{"url":"voice/char_126_shotst/cn_011.wav","text":"你好，我是流星，来自森林的弓箭手。您需要擅长远程援护的干员吗？"}],"作战记录":[{"url":"voice/char_126_shotst/cn_012.wav","text":"弓术的练习，哪怕一天也不能松懈呀。"}],"精英化1":[{"url":"voice/char_126_shotst/cn_013.wav","text":"我很荣幸获得这次晋升机会。"}],"精英化2":[{"url":"voice/char_126_shotst/cn_014.wav","text":"谢谢博士的认可。今后就让我继续为博士贡献自己的力量吧。"}],"编入":[{"url":"voice/char_126_shotst/cn_017.wav","text":"远程援护就交给我吧。"}],"任命队长":[{"url":"voice/char_126_shotst/cn_018.wav","text":"我会照顾好大家的。"}],"行动出发":[{"url":"voice/char_126_shotst/cn_019.wav","text":"伙伴们，出发。"}],"行动开始":[{"url":"voice/char_126_shotst/cn_020.wav","text":"展示我们力量的时候到了。"}],"选中":[{"url":"voice/char_126_shotst/cn_021.wav","text":"请您下令。"},{"url":"voice/char_126_shotst/cn_022.wav","text":"我已等候多时。"}],"部署":[{"url":"voice/char_126_shotst/cn_023.wav","text":"风吹向了正确的地方。"},{"url":"voice/char_126_shotst/cn_024.wav","text":"我会保持警戒。"}],"技能":[{"url":"voice/char_126_shotst/cn_025.wav","text":"有破绽！"},{"url":"voice/char_126_shotst/cn_026.wav","text":"风！"},{"url":"voice/char_126_shotst/cn_027.wav","text":"就是这一箭！"},{"url":"voice/char_126_shotst/cn_028.wav","text":"致命一击。"}],"高难胜利":[{"url":"voice/char_126_shotst/cn_029.wav","text":"不管是什么样的难关，只要我们齐心协力，就一定能克服过去。"}],"3星胜利":[{"url":"voice/char_126_shotst/cn_030.wav","text":"干的漂亮，大家都是最棒的。"}],"非3星胜利":[{"url":"voice/char_126_shotst/cn_031.wav","text":"请伤者留在原地，别乱动，我马上就去帮你。"}],"失败":[{"url":"voice/char_126_shotst/cn_032.wav","text":"抱歉，不应该是这样的......"}],"进驻":[{"url":"voice/char_126_shotst/cn_033.wav","text":"我还是不太习惯这么狭小的房间啊。"}],"戳一下":[{"url":"voice/char_126_shotst/cn_034.wav","text":"哎呀？有什么事吗？"}],"信赖触摸":[{"url":"voice/char_126_shotst/cn_036.wav","text":"和博士在一起的时光，就像沐浴在春天的阳光里一样温暖，很舒服。"}],"标题":[{"url":"voice/char_126_shotst/cn_037.wav","text":"明日方舟。"}],"新年":[{"url":"voice/char_126_shotst/cn_038.wav","text":"又是一年了，森林是不是还和我当初离去时一样呢？虽然我仍旧有些不习惯现代生活，人们对矿石病的恐惧也似乎并没有减少，但是，新年的到来让这片大地重新焕发生机，万事都还是有希望的吧。"}],"问候":[{"url":"voice/char_126_shotst/cn_042.wav","text":"博士，您好。"}]}}