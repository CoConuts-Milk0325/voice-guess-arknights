{"中文":{"登录":[{"url":"voice_cn/char_158_milu/cn_001.wav","text":"我正在警戒四周，没有问题。"}],"交谈":[{"url":"voice_cn/char_158_milu/cn_002.wav","text":"一些注视着你的视线是饱含恶意的。即使在罗德岛，您也并不安全。"},{"url":"voice_cn/char_158_milu/cn_003.wav","text":"没必要害怕那些阴影中的敌人，这些罪人无论用什么方法躲藏，都欺骗不了我的眼睛。"},{"url":"voice_cn/char_158_milu/cn_004.wav","text":"即使牺牲我的生命，也一定要完成这次复仇。"}],"晋升交谈":[{"url":"voice_cn/char_158_milu/cn_005.wav","text":"我的族人和朋友，都葬身在故乡的森林里。只有落叶能掩埋他们。"},{"url":"voice_cn/char_158_milu/cn_006.wav","text":"这把弩是为了审判罪人制造的。终有一天，我要用它降下最后的裁决。"}],"信赖":[{"url":"voice_cn/char_158_milu/cn_007.wav","text":"陨星。她曾经是我的朋友。我的故乡被摧毁的那天，只有我们几个人设法逃了出来。"},{"url":"voice_cn/char_158_milu/cn_008.wav","text":"我一直在找那个告密者，把叛军引向故乡的罪人......会是陨星吗？不，我、我不认为是她——"},{"url":"voice_cn/char_158_milu/cn_009.wav","text":"——我睡着了？抱、抱歉，最近巡逻的时间增加了......不，即使您说没关系也......谢谢您的关心。"}],"闲置":[{"url":"voice_cn/char_158_milu/cn_010.wav","text":"我想稍微睡一下......"}],"报到":[{"url":"voice_cn/char_158_milu/cn_011.wav","text":"狙击手守林人。为了复仇，我需要强大力量的帮助。"}],"作战记录":[{"url":"voice_cn/char_158_milu/cn_012.wav","text":"我需要更多的力量。"}],"精英化1":[{"url":"voice_cn/char_158_milu/cn_013.wav","text":"感谢您的任命。"}],"精英化2":[{"url":"voice_cn/char_158_milu/cn_014.wav","text":"任命，感谢。从今以后，也请将我的力量用于正途，否则......"}],"编入":[{"url":"voice_cn/char_158_milu/cn_017.wav","text":"组队完成。"}],"任命队长":[{"url":"voice_cn/char_158_milu/cn_018.wav","text":"了解。"}],"行动出发":[{"url":"voice_cn/char_158_milu/cn_019.wav","text":"全体干员出击。"}],"行动开始":[{"url":"voice_cn/char_158_milu/cn_020.wav","text":"发现敌情，立即采取行动。"}],"选中":[{"url":"voice_cn/char_158_milu/cn_021.wav","text":"了解。"},{"url":"voice_cn/char_158_milu/cn_022.wav","text":"请下达指令。"}],"部署":[{"url":"voice_cn/char_158_milu/cn_023.wav","text":"现在进行索敌。"},{"url":"voice_cn/char_158_milu/cn_024.wav","text":"到达目标地点。"}],"技能":[{"url":"voice_cn/char_158_milu/cn_025.wav","text":"援护。"},{"url":"voice_cn/char_158_milu/cn_026.wav","text":"瞄准。"},{"url":"voice_cn/char_158_milu/cn_027.wav","text":"发射。"},{"url":"voice_cn/char_158_milu/cn_028.wav","text":"开火！"}],"高难胜利":[{"url":"voice_cn/char_158_milu/cn_029.wav","text":"我会一直走下去，直到彻底实现复仇那天。"}],"3星胜利":[{"url":"voice_cn/char_158_milu/cn_030.wav","text":"作战结束。歼灭了所有目标。"}],"非3星胜利":[{"url":"voice_cn/char_158_milu/cn_031.wav","text":"战斗结束。有必要确认残余敌人的情况。"}],"失败":[{"url":"voice_cn/char_158_milu/cn_032.wav","text":"马上撤退......"}],"进驻":[{"url":"voice_cn/char_158_milu/cn_033.wav","text":"不习惯热闹的房间......"}],"戳一下":[{"url":"voice_cn/char_158_milu/cn_034.wav","text":"啊......"}],"信赖触摸":[{"url":"voice_cn/char_158_milu/cn_036.wav","text":"那个，摸我的角的话，有点为难......很痒......"}],"标题":[{"url":"voice_cn/char_158_milu/cn_037.wav","text":"明日方舟。"}],"新年":[{"url":"voice_cn/char_158_milu/cn_038.wav","text":"新年？虽然有些太过吵闹，但是之前在森林里，我们也有这样的日子......我们一起围着篝火唱歌，用藤条编织手串互相赠送......博士想听我们当地的那些歌吗？我还记得它们。"}],"问候":[{"url":"voice_cn/char_158_milu/cn_042.wav","text":"嗯？博士啊。"}]},"日文":{"登录":[{"url":"voice/char_158_milu/cn_001.wav","text":"我正在警戒四周，没有问题。"}],"交谈":[{"url":"voice/char_158_milu/cn_002.wav","text":"一些注视着你的视线是饱含恶意的。即使在罗德岛，您也并不安全。"},{"url":"voice/char_158_milu/cn_003.wav","text":"没必要害怕那些阴影中的敌人，这些罪人无论用什么方法躲藏，都欺骗不了我的眼睛。"},{"url":"voice/char_158_milu/cn_004.wav","text":"即使牺牲我的生命，也一定要完成这次复仇。"}],"晋升交谈":[{"url":"voice/char_158_milu/cn_005.wav","text":"我的族人和朋友，都葬身在故乡的森林里。只有落叶能掩埋他们。"},{"url":"voice/char_158_milu/cn_006.wav","text":"这把弩是为了审判罪人制造的。终有一天，我要用它降下最后的裁决。"}],"信赖":[{"url":"voice/char_158_milu/cn_007.wav","text":"陨星。她曾经是我的朋友。我的故乡被摧毁的那天，只有我们几个人设法逃了出来。"},{"url":"voice/char_158_milu/cn_008.wav","text":"我一直在找那个告密者，把叛军引向故乡的罪人......会是陨星吗？不，我、我不认为是她——"},{"url":"voice/char_158_milu/cn_009.wav","text":"——我睡着了？抱、抱歉，最近巡逻的时间增加了......不，即使您说没关系也......谢谢您的关心。"}],"闲置":[{"url":"voice/char_158_milu/cn_010.wav","text":"我想稍微睡一下......"}],"报到":[{"url":"voice/char_158_milu/cn_011.wav","text":"狙击手守林人。为了复仇，我需要强大力量的帮助。"}],"作战记录":[{"url":"voice/char_158_milu/cn_012.wav","text":"我需要更多的力量。"}],"精英化1":[{"url":"voice/char_158_milu/cn_013.wav","text":"感谢您的任命。"}],"精英化2":[{"url":"voice/char_158_milu/cn_014.wav","text":"任命，感谢。从今以后，也请将我的力量用于正途，否则......"}],"编入":[{"url":"voice/char_158_m