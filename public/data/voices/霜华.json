{
  "中文": {
    "登录": [
      {
        "url": "voice/char_458_rfrost/cn_001.wav",
        "text": "这是日程表，还有周报、开支表、议程表等待审阅......您想先看哪份？"
      }
    ],
    "交谈": [
      {
        "url": "voice/char_458_rfrost/cn_002.wav",
        "text": "通力合作，我们必将披荆斩棘。"
      },
      {
        "url": "voice/char_458_rfrost/cn_003.wav",
        "text": "不介意我整理一下书架吧，长官。"
      },
      {
        "url": "voice/char_458_rfrost/cn_004.wav",
        "text": "人表现出的行为有时和野兽并无区别，了解这份相似性，能够令我更好的履行职责。"
      }
    ],
    "晋升交谈": [
      {
        "url": "voice/char_458_rfrost/cn_005.wav",
        "text": "为了欣赏值得观看的东西，我们总要远离城市，这就是我经常远行的原因。"
      },
      {
        "url": "voice/char_458_rfrost/cn_006.wav",
        "text": "放置迎宾踏垫只是第一步，如何把猎物引向踏垫才是值得考虑的事。"
      }
    ],
    "信赖": [
      {
        "url": "voice/char_458_rfrost/cn_007.wav",
        "text": "不不不，这样不对，我再思考一下......"
      },
      {
        "url": "voice/char_458_rfrost/cn_008.wav",
        "text": "有什么我能帮忙的吗？"
      },
      {
        "url": "voice/char_458_rfrost/cn_009.wav",
        "text": "只有自然和战场才能决定谁是猎人，谁是猎物。"
      }
    ],
    "闲置": [
      {
        "url": "voice/char_458_rfrost/cn_010.wav",
        "text": "只要在这里拉根细绳，还有一个迎宾踏垫......"
      }
    ],
    "报到": [
      {
        "url": "voice/char_458_rfrost/cn_011.wav",
        "text": "彩虹小队所属，代号霜华，请下命令吧，长官。"
      }
    ],
    "作战记录": [
      {
        "url": "voice/char_458_rfrost/cn_012.wav",
        "text": "我有个好点子。"
      }
    ],
    "精英化1": [
      {
        "url": "voice/char_458_rfrost/cn_013.wav",
        "text": "感谢您的信任，长官。"
      }
    ],
    "精英化2": [
      {
        "url": "voice/char_458_rfrost/cn_014.wav",
        "text": "在生死攸关之际，我们最迫切渴求的东西莫过于两样：水源，以及希望。"
      }
    ],
    "编入": [
      {
        "url": "voice/char_458_rfrost/cn_017.wav",
        "text": "让我们一起合作。"
      }
    ],
    "任命队长": [
      {
        "url": "voice/char_458_rfrost/cn_018.wav",
        "text": "别忘了，我们是一个有计划的团队。"
      }
    ],
    "行动出发": [
      {
        "url": "voice/char_458_rfrost/cn_019.wav",
        "text": "是时候看看这些计划的效果了。"
      }
    ],
    "行动开始": [
      {
        "url": "voice/char_458_rfrost/cn_020.wav",
        "text": "我看到敌方了。"
      }
    ],
    "选中": [
      {
        "url": "voice/char_458_rfrost/cn_021.wav",
        "text": "我们准备好迎接客人了。"
      },
      {
        "url": "voice/char_458_rfrost/cn_022.wav",
        "text": "设置封阻物。"
      }
    ],
    "部署": [
      {
        "url": "voice/char_458_rfrost/cn_023.wav",
        "text": "别让他们偷袭你。"
      },
      {
        "url": "voice/char_458_rfrost/cn_024.wav",
        "text": "保持警戒。"
      }
    ],
    "技能": [
      {
        "url": "voice/char_458_rfrost/cn_025.wav",
        "text": "摆放迎宾踏垫中。"
      },
      {
        "url": "voice/char_458_rfrost/cn_026.wav",
        "text": "安装中。"
      },
      {
        "url": "voice/char_458_rfrost/cn_027.wav",
        "text": "迎宾踏垫已设置。"
      },
      {
        "url": "voice/char_458_rfrost/cn_028.wav",
        "text": "部署完毕。"
      }
    ],
    "高难胜利": [
      {
        "url": "voice/char_458_rfrost/cn_029.wav",
        "text": "每时每刻都要有比敌人更万全的准备。"
      }
    ],
    "3星胜利": [
      {
        "url": "voice/char_458_rfrost/cn_030.wav",
        "text": "永远记得未雨绸缪。"
      }
    ],
    "非3星胜利": [
      {
        "url": "voice/char_458_rfrost/cn_031.wav",
        "text": "注意周边警戒。"
      }
    ],
    "失败": [
      {
        "url": "voice/char_458_rfrost/cn_032.wav",
        "text": "正在救援，友军受伤。"
      }
    ],
    "进驻": [
      {
        "url": "voice/char_458_rfrost/cn_033.wav",
        "text": "不是那么坏。"
      }
    ],
    "戳一下": [
      {
        "url": "voice/char_458_rfrost/cn_034.wav",
        "text": "嘿，小心点！"
      }
    ],
    "信赖触摸": [
      {
        "url": "voice/char_458_rfrost/cn_036.wav",
        "text": "来，加入我们的狩猎。"
      }
    ],
    "标题": [
      {
        "url": "voice/char_458_rfrost/cn_037.wav",
        "text": "明日方舟。"
      }
    ],
    "问候": [
      {
        "url": "voice/char_458_rfrost/cn_042.wav",
        "text": "想生个火吗？"
      }
    ]
  },
