{"中文":{"登录":[{"url":"voice_cn/char_240_wyvern/cn_001.wav","text":"等候您的命令，博士。"}],"交谈":[{"url":"voice_cn/char_240_wyvern/cn_002.wav","text":"生化小组的两位前辈也在这里？那......以后能把我分配到前辈们的行动组吗？"},{"url":"voice_cn/char_240_wyvern/cn_003.wav","text":"呼哈......呼哈......再做三组体能训练......今天的锻炼就完成了......一半......博士......麻烦您帮我......拿下水壶......"},{"url":"voice_cn/char_240_wyvern/cn_004.wav","text":"想问我家乡的情况？那是片......残酷的荒漠，每天光是活着就很累了。和那里比起来，罗德岛就是天堂啊。"}],"晋升交谈":[{"url":"voice_cn/char_240_wyvern/cn_005.wav","text":"比起在黑钢实习的时候，我变得更强了。"}],"信赖":[{"url":"voice_cn/char_240_wyvern/cn_007.wav","text":"黑钢的第二十二条规定：“武器离身者一律辞退”，所以我一直随身带着我的斧枪。唉？平时不用？但我记得......稍等......“此规定仅限入职训练与契约中干员。”......芙兰卡小姐为什么没提醒我呢......"},{"url":"voice_cn/char_240_wyvern/cn_008.wav","text":"杜宾教官太残忍了！为什么只有我要面对活生生的源石蜗牛呢！我，我真的下不了手啊！"},{"url":"voice_cn/char_240_wyvern/cn_009.wav","text":"我想......我明白芙兰卡和雷蛇待在罗德岛的原因了。可能和黑钢相比，这里更像个家吧。除了任务之外，居然还有那么多有趣的东西......"}],"闲置":[{"url":"voice_cn/char_240_wyvern/cn_010.wav","text":"嘘，安静点，别打扰博士休息。"}],"报到":[{"url":"voice_cn/char_240_wyvern/cn_011.wav","text":"香草，以受训干员的身份前来学习。博士阁下，今后就请您多多指教了。"}],"作战记录":[{"url":"voice_cn/char_240_wyvern/cn_012.wav","text":"是时候整理笔记了，新知识得赶紧消化掉。"}],"精英化1":[{"url":"voice_cn/char_240_wyvern/cn_013.wav","text":"这是......晋升勋章？给我的？谢，谢谢！"}],"编入":[{"url":"voice_cn/char_240_wyvern/cn_017.wav","text":"香草会助大家一臂之力的！"}],"任命队长":[{"url":"voice_cn/char_240_wyvern/cn_018.wav","text":"我的话，真的可以吗？"}],"行动出发":[{"url":"voice_cn/char_240_wyvern/cn_019.wav","text":"我会加倍努力的。"}],"行动开始":[{"url":"voice_cn/char_240_wyvern/cn_020.wav","text":"不能给黑钢的各位丢脸！"}],"选中":[{"url":"voice_cn/char_240_wyvern/cn_021.wav","text":"嗯？"},{"url":"voice_cn/char_240_wyvern/cn_022.wav","text":"我会听从命令。"}],"部署":[{"url":"voice_cn/char_240_wyvern/cn_023.wav","text":"好的。"},{"url":"voice_cn/char_240_wyvern/cn_024.wav","text":"明白。"}],"技能":[{"url":"voice_cn/char_240_wyvern/cn_025.wav","text":"不会让你过去！"},{"url":"voice_cn/char_240_wyvern/cn_026.wav","text":"这把斧头可不是装饰品！"},{"url":"voice_cn/char_240_wyvern/cn_027.wav","text":"战斗可不仅仅是依靠经验！"},{"url":"voice_cn/char_240_wyvern/cn_028.wav","text":"接下我这一击！"}],"高难胜利":[{"url":"voice_cn/char_240_wyvern/cn_029.wav","text":"呼，大圆满！"}],"3星胜利":[{"url":"voice_cn/char_240_wyvern/cn_030.wav","text":"很成功的作战。"}],"非3星胜利":[{"url":"voice_cn/char_240_wyvern/cn_031.wav","text":"如果再努力些的话，结果会更好点吧。"}],"失败":[{"url":"voice_cn/char_240_wyvern/cn_032.wav","text":"我......能力还不够......"}],"进驻":[{"url":"voice_cn/char_240_wyvern/cn_033.wav","text":"听从您的指挥。"}],"戳一下":[{"url":"voice_cn/char_240_wyvern/cn_034.wav","text":"唉唉？"}],"信赖触摸":[{"url":"voice_cn/char_240_wyvern/cn_036.wav","text":"博士，要一起吃晚饭吗？"}],"标题":[{"url":"voice_cn/char_240_wyvern/cn_037.wav","text":"明日方舟。"}],"新年":[{"url":"voice_cn/char_240_wyvern/cn_038.wav","text":"新年快乐！这么多好吃的，还有晚会，真好啊......在老家的时候，晚上能吃几道菜，完全取决于白天打到了多少猎物。所以为了庆祝新年，一大早就要出去打猎，实在很辛苦......"}],"问候":[{"url":"voice_cn/char_240_wyvern/cn_042.wav","text":"博士，早。"}]},"日文":{"登录":[{"url":"voice/char_240_wyvern/cn_001.wav","text":"等候您的命令，博士。"}],"交谈":[{"url":"voice/char_240_wyvern/cn_002.wav","text":"生化小组的两位前辈也在这里？那......以后能把我分配到前辈们的行动组吗？"},{"url":"voice/char_240_wyvern/cn_003.wav","text":"呼哈......呼哈......再做三组体能训练......今天的锻炼就完成了......一半......博士......麻烦您帮我......拿下水壶......"},{"url":"voice/char_240_wyvern/cn_004.wav","text":"想问我家乡的情况？那是片......残酷的荒漠，每天光是活着就很累了。和那里比起来，罗德岛就是天堂啊。"}],"晋升交谈":[{"url":"voice/char_240_wyvern/cn_005.wav","text":"比起在黑钢实习的时候，我变得更强了。"}],"信赖":[{"url":"voice/char_240_wyvern/cn_007.wav","text":"黑钢的第二十二条规定：“武器离身者一律辞退”，所以我一直随身带着我的斧枪。唉？平时不用？但我记得......稍等......“此规定仅限入职训练与契约中干员。”......芙兰卡小姐为什么没提醒我呢......"},{"url":"voice/char_240_wyvern/cn_008.wav","text":"杜宾教官太残忍了！为什么只有我要面对活生生的源石蜗牛呢！我，我真的下不了手啊！"},{"url":"voice/char_240_wyvern/cn_009.wav","text":"我想......我明白芙兰卡和雷蛇待在罗德岛的原因了。可能和黑钢相比，这里更像个家吧。除了任务之外，居然还有那么多有趣的东西......"}],"闲置":[{"url":"voice/char_240_wyvern/cn_010.wav","text":"嘘，安静点，别打扰博士休息。"}],"报到":[{"url":"voice/char_240_wyvern/cn_011.wav","text":"香草，以受训干员的身份前来学习。博士阁下，今后就请您多多指教了。"}],"作战记录":[{"url":"voice/char_240_wyvern/cn_012.wav","text":"是时候整理笔记了，新知识得赶紧消化掉。"}],"精英化1":[{"url":"v