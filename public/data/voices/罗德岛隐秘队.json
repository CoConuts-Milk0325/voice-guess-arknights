{
  "中文": {
    "登录": [
      {
        "url": "voice/char_4215_buddy/cn_001.wav",
        "text": "博士和梓兰一样，每天都要讨伐名为“文件”的怪物喵？"
      }
    ],
    "交谈": [
      {
        "url": "voice/char_4215_buddy/cn_002.wav",
        "text": "义经，你还记得随从广场的样子喵？确实喵，这里应该这样画喵——好，这一话完成了，赶紧去给斑点看看喵！没错，把家乡的故事画出来是怀念家乡最好的方式喵，提出这个点子的斑点真聪明喵！"
      },
      {
        "url": "voice/char_4215_buddy/cn_003.wav",
        "text": "泡普卡和宝巫迦陛下的性格完全不同喵！之前她一直盯着我看，我还以为自己做了什么坏事，害怕得睡不着喵！壮着胆子去问她，原来只是想摸摸我喵！现在已经是能够一起睡觉的好朋友了喵！"
      },
      {
        "url": "voice/char_4215_buddy/cn_004.wav",
        "text": "博士，对不起喵！义经之前在训练中差点伤到月见夜喵！因为他把月见夜认成了那个百折不挠的将军，所以下意识就——啊，不是说这边的月见夜不够坚强的意思喵！"
      }
    ],
    "信赖": [
      {
        "url": "voice/char_4215_buddy/cn_007.wav",
        "text": "空爆又不见了？我去帮梓兰找找喵！什么，义经，你要拦我？！你居然站在空爆那边喵？！没办法了，决一胜负吧喵！"
      },
      {
        "url": "voice/char_4215_buddy/cn_008.wav",
        "text": "博士也想使用翔虫喵？没问题喵！抓住它尾部分泌的丝线，然后往想要的方向丢出去——糟糕，博士把自己甩飞了，义经，快接住喵！"
      },
      {
        "url": "voice/char_4215_buddy/cn_009.wav",
        "text": "喵？！开会要来不及了？义经——博士，义经让你骑上他喵！但是，要小心，义经的速度很快，以博士的体质——啊，走掉了喵。好像已经听到博士的惨叫声了，没办法，去给博士送药吧喵。"
      }
    ],
    "闲置": [
      {
        "url": "voice/char_4215_buddy/cn_010.wav",
        "text": "义经，你压到我的尾巴了喵......喵？原来是博士喵......"
      }
    ],
    "报到": [
      {
        "url": "voice/char_4215_buddy/cn_011.wav",
        "text": "我们是来自炎火村随从隐秘队的政宗和义经喵！调查情报和收集素材就交给我们喵！呼——比第一次见到前代陛下时的自我介绍好多了喵！"
      }
    ],
    "作战记录": [
      {
        "url": "voice/char_4215_buddy/cn_012.wav",
        "text": "强大的猎人果然都有各自独特的战斗方式喵！"
      }
    ],
    "编入": [
      {
        "url": "voice/char_4215_buddy/cn_017.wav",
        "text": "狩猎也好，调查也好，都交给我们喵！"
      }
    ],
    "任命队长": [
      {
        "url": "voice/char_4215_buddy/cn_018.wav",
        "text": "没错，这可是我们表现的好机会喵！"
      }
    ],
    "行动出发": [
      {
        "url": "voice/char_4215_buddy/cn_019.wav",
        "text": "狩猎开始喵！"
      }
    ],
    "行动开始": [
      {
        "url": "voice/char_4215_buddy/cn_020.wav",
        "text": "博士，义经嗅到了敌人的味道喵！"
      }
    ],
    "选中": [
      {
        "url": "voice/char_4215_buddy/cn_021.wav",
        "text": "义经说，敌人就在附近了喵！"
      },
      {
        "url": "voice/char_4215_buddy/cn_022.wav",
        "text": "义经，不要冲动喵！"
      }
    ],
    "部署": [
      {
        "url": "voice/char_4215_buddy/cn_023.wav",
        "text": "交给我们喵！"
      },
      {
        "url": "voice/char_4215_buddy/cn_024.wav",
        "text": "一定要带回让博士满意的情报和素材喵！"
      }
    ],
    "技能": [
      {
        "url": "voice/char_4215_buddy/cn_025.wav",
        "text": "让你们见识一下隐秘队的实力喵！"
      },
      {
        "url": "voice/char_4215_buddy/cn_026.wav",
        "text": "一鼓作气解决他们喵！"
      },
      {
        "url": "voice/char_4215_buddy/cn_027.wav",
        "text": "差点打到我了喵！"
      },
      {
        "url": "voice/char_4215_buddy/cn_028.wav",
        "text": "感觉能获得很好的素材喵！"
      }
    ],
    "高难胜利": [
      {
        "url": "voice/char_4215_buddy/cn_029.wav",
        "text": "能够指挥完成这么困难的任务，博士简直就和那些传说中的猎人一样了不起喵！"
      }
    ],
    "3星胜利": [
      {
        "url": "voice/char_4215_buddy/cn_030.wav",
        "text": "这次会获得什么样的稀有素材呢，好期待喵！"
      }
    ],
    "非3星胜利": [
      {
        "url": "voice/char_4215_buddy/cn_031.wav",
        "text": "博士，不能掉以轻心，附近还有敌人喵！"
      }
    ],
    "失败": [
      {
        "url": "voice/char_4215_buddy/cn_032.wav",
        "text": "板车准备好了，快把博士运回去喵！"
      }
    ],
    "进驻": [
      {
        "url": "voice/char_4215_buddy/cn_033.wav",
        "text": "不知道罗德岛和炎火村的锻造场比，哪个比较大喵？"
      }
    ],
    "戳一下": [
      {
        "url": "voice/char_4215_buddy/cn_034.wav",
        "text": "敌袭喵？原来是博士喵！"
      }
    ],
    "信赖触摸": [
      {
        "url": "voice/char_4215_buddy/cn_036.wav",
        "text": "罗德岛上的各种器械，好复杂喵......"
      }
    ],
    "标题": [
      {
        "url": "voice/char_4215_buddy/cn_037.wav",
        "text": "明日方舟。"
      }
    ],
    "新年": [
      {
        "url": "voice/char_4215_buddy/cn_038.wav",
        "text": "义经，你应该明白的喵？离开炎火村的十年来，我们从未真正分出胜负。哼，别以为只有你变强了，我也变强了喵。今天，是时候了喵，就在这场雪仗里决一胜负——空爆，你偷袭我喵！"
      }
    ],
    "问候": [
      {
        "url": "voice/char_4215_buddy/cn_042.wav",
        "text": "博士，一起去狩猎喵！"
      }
    ]
  },
