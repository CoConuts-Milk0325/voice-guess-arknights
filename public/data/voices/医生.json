{"中文":{"登录":[{"url":"voice_cn/char_4125_rdoc/cn_001.wav","text":"这是你需要的文件，这是给你带的咖啡，不用谢。"}],"交谈":[{"url":"voice_cn/char_4125_rdoc/cn_002.wav","text":"有什么事情吗......哦！抱歉，博士，我还以为刚刚那位干员是喊我来着。"},{"url":"voice_cn/char_4125_rdoc/cn_003.wav","text":"能拿得起柳叶刀就能端得起枪，永远别怀疑一个医生的手有多稳。"},{"url":"voice_cn/char_4125_rdoc/cn_004.wav","text":"我会竭尽全力拯救目标，不论是伤病还是敌人，都不能将他们从我手中夺走。"}],"晋升交谈":[{"url":"voice_cn/char_4125_rdoc/cn_005.wav","text":"人步入战场，与死亡同行，便会明白生命的宝贵。"},{"url":"voice_cn/char_4125_rdoc/cn_006.wav","text":"过去的经验告诉我，想要救死扶伤就该亲临现场，而不是坐在办公室里。而有时候，拯救生命的唯一手段，是夺走另外一个生命。"}],"信赖":[{"url":"voice_cn/char_4125_rdoc/cn_007.wav","text":"我的工作是保护你的人身安全，我不介意你给我来点挑战。"},{"url":"voice_cn/char_4125_rdoc/cn_008.wav","text":"发生什么了？我可不喜欢看人们愁眉不展的样子。"},{"url":"voice_cn/char_4125_rdoc/cn_009.wav","text":"博士，我很庆幸我们找到了你。"}],"闲置":[{"url":"voice_cn/char_4125_rdoc/cn_010.wav","text":"快停下手头的工作吧，你上次休息是什么时候？"}],"报到":[{"url":"voice_cn/char_4125_rdoc/cn_011.wav","text":"彩虹小队成员，代号医生。放心，我会保护你的安全。"}],"作战记录":[{"url":"voice_cn/char_4125_rdoc/cn_012.wav","text":"这样一来，事情就轻松多了。"}],"精英化1":[{"url":"voice_cn/char_4125_rdoc/cn_013.wav","text":"如果我们必须这样做，那就这样做。"}],"精英化2":[{"url":"voice_cn/char_4125_rdoc/cn_014.wav","text":"谢谢你，我正好需要更高的权限来阅读关于矿石病的机密文献。"}],"编入":[{"url":"voice_cn/char_4125_rdoc/cn_017.wav","text":"需要帮忙就叫我。"}],"任命队长":[{"url":"voice_cn/char_4125_rdoc/cn_018.wav","text":"任务中注意安全。"}],"行动出发":[{"url":"voice_cn/char_4125_rdoc/cn_019.wav","text":"至少我们准备充分。"}],"行动开始":[{"url":"voice_cn/char_4125_rdoc/cn_020.wav","text":"本区域内尚有活动的敌人。"}],"选中":[{"url":"voice_cn/char_4125_rdoc/cn_021.wav","text":"准备就绪。"},{"url":"voice_cn/char_4125_rdoc/cn_022.wav","text":"我会保护你们。"}],"部署":[{"url":"voice_cn/char_4125_rdoc/cn_023.wav","text":"赶紧动起来。"},{"url":"voice_cn/char_4125_rdoc/cn_024.wav","text":"尽量别让自己受伤。"}],"技能":[{"url":"voice_cn/char_4125_rdoc/cn_025.wav","text":"目标已定位。"},{"url":"voice_cn/char_4125_rdoc/cn_026.wav","text":"发现目标。"},{"url":"voice_cn/char_4125_rdoc/cn_027.wav","text":"跟紧我。"},{"url":"voice_cn/char_4125_rdoc/cn_028.wav","text":"正在换弹！"}],"高难胜利":[{"url":"voice_cn/char_4125_rdoc/cn_029.wav","text":"你还好吗？有没有觉得呼吸困难？"}],"3星胜利":[{"url":"voice_cn/char_4125_rdoc/cn_030.wav","text":"即将抵达撤离点，我们马上就可以休息了。"}],"非3星胜利":[{"url":"voice_cn/char_4125_rdoc/cn_031.wav","text":"我们会让你好起来的，好吗？"}],"失败":[{"url":"voice_cn/char_4125_rdoc/cn_032.wav","text":"我们在浪费时间。"}],"进驻":[{"url":"voice_cn/char_4125_rdoc/cn_033.wav","text":"乐意之至。"}],"戳一下":[{"url":"voice_cn/char_4125_rdoc/cn_034.wav","text":"小心，我刚拿了一堆瓶瓶罐罐。"}],"信赖触摸":[{"url":"voice_cn/char_4125_rdoc/cn_036.wav","text":"没什么，有情况我会及时告知你。"}],"标题":[{"url":"voice_cn/char_4125_rdoc/cn_037.wav","text":"明日方舟。"}],"问候":[{"url":"voice_cn/char_4125_rdoc/cn_042.wav","text":"你好。"}]},"日文":{"登录":[{"url":"voice/char_4125_rdoc/cn_001.wav","text":"这是你需要的文件，这是给你带的咖啡，不用谢。"}],"交谈":[{"url":"voice/char_4125_rdoc/cn_002.wav","text":"有什么事情吗......哦！抱歉，博士，我还以为刚刚那位干员是喊我来着。"},{"url":"voice/char_4125_rdoc/cn_003.wav","text":"能拿得起柳叶刀就能端得起枪，永远别怀疑一个医生的手有多稳。"},{"url":"voice/char_4125_rdoc/cn_004.wav","text":"我会竭尽全力拯救目标，不论是伤病还是敌人，都不能将他们从我手中夺走。"}],"晋升交谈":[{"url":"voice/char_4125_rdoc/cn_005.wav","text":"人步入战场，与死亡同行，便会明白生命的宝贵。"},{"url":"voice/char_4125_rdoc/cn_006.wav","text":"过去的经验告诉我，想要救死扶伤就该亲临现场，而不是坐在办公室里。而有时候，拯救生命的唯一手段，是夺走另外一个生命。"}],"信赖":[{"url":"voice/char_4125_rdoc/cn_007.wav","text":"我的工作是保护你的人身安全，我不介意你给我来点挑战。"},{"url":"voice/char_4125_rdoc/cn_008.wav","text":"发生什么了？我可不喜欢看人们愁眉不展的样子。"},{"url":"voice/char_4125_rdoc/cn_009.wav","text":"博士，我很庆幸我们找到了你。"}],"闲置":[{"url":"voice/char_4125_rdoc/cn_010.wav","text":"快停下手头的工作吧，你上次休息是什么时候？"}],"报到":[{"url":"voice/char_4125_rdoc/cn_011.wav","text":"彩虹小队成员，代号医生。放心，我会保护你的安全。"}],"作战记录":[{"url":"voice/char_4125_rdoc/cn_012.wav","text":"这样一来，事情就轻松多了。"}],"精英化1":[{"url":"voice/char_4125_rdoc/cn_013.wav","text":"如果我们必须这样做，那就这样做。"}],"精英化2":[{"url":"voice/char_4125_rdoc/cn_014.wav","text":"谢谢你，我正好需要更高的权限来阅读关于矿石病的机密文献。"}],"编入":[{"url":"voice/char_4125_rdoc/cn_017.wav","text":"需要帮忙就叫我。"}],"任命队长":[{"url":"voice/char_4125_rdoc/cn_018.wav","text":"任务中注意安全。"}],"行动出发":[{"url":"vo