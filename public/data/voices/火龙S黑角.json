{
  "中文": {
    "登录": [
      {
        "url": "voice/char_1030_noirc2/cn_001.wav",
        "text": "好，让俺来帮忙吧！不用担心，俺现在已经适应了这副装备，不会再撞到周围了！"
      }
    ],
    "交谈": [
      {
        "url": "voice/char_1030_noirc2/cn_002.wav",
        "text": "外出工作之余，照顾好自己和同伴的饮食也挺重要的。博士，俺最近学习了使用简易烤肉架处理生肉，俺现在就在这里给你露一手！"
      },
      {
        "url": "voice/char_1030_noirc2/cn_003.wav",
        "text": "过去在泰拉各地也都没见过这样耐用且舒适的装备，感觉穿上它们，俺的攻击力提高了，并且还能精准打击敌人的弱点，还能提高火焰攻击的能力！大概是俺的错觉吧？"
      },
      {
        "url": "voice/char_1030_noirc2/cn_004.wav",
        "text": "听艾露猫们说，越是经验老到的猎人，越会做好任务出发前的准备。带好药水和道具，也是狩猎的关键部分。不过俺老是被夜刀骂，说俺每次出什么任务都会带太多东西哈哈，真不简单啊。"
      }
    ],
    "晋升交谈": [
      {
        "url": "voice/char_1030_noirc2/cn_005.wav",
        "text": "一直称手的盾不在手边，还真是让俺有些不习惯。不过听艾露猫们说过，只要使用得当，用这把太刀也能招架各种攻击。看来俺的练习之路还长着呢。"
      },
      {
        "url": "voice/char_1030_noirc2/cn_006.wav",
        "text": "只有面对了足够多的敌人，才能将作战技巧融会贯通。果然提升自己是没有任何捷径的，特别是俺这样的笨人哈哈。"
      }
    ],
    "信赖": [
      {
        "url": "voice/char_1030_noirc2/cn_007.wav",
        "text": "研磨用的砥石平平无奇，却不可或缺。即使是如此削铁如泥的好刀，在它的一生里都得时时刻刻不停打磨下去。"
      },
      {
        "url": "voice/char_1030_noirc2/cn_008.wav",
        "text": "现在俺也依然只想做一个努力做好本分工作的小人物。有着自己的职责，有着自己的烦恼，有着自己的守护对象。"
      },
      {
        "url": "voice/char_1030_noirc2/cn_009.wav",
        "text": "不带盾牌，使用这样的太刀作武器，确实经常会让俺想起过去那段不堪回忆的日子。不过，如果没有那些过去，也没有现在的俺和夜刀吧。"
      }
    ],
    "闲置": [
      {
        "url": "voice/char_1030_noirc2/cn_010.wav",
        "text": "博士好好休息，这里就交给俺吧。"
      }
    ],
    "报到": [
      {
        "url": "voice/char_1030_noirc2/cn_011.wav",
        "text": "干员黑角，带着新的装备来接受博士的指挥了！不管敌人是暴徒还是凶恶的生物，都交给俺来处理吧！"
      }
    ],
    "作战记录": [
      {
        "url": "voice/char_1030_noirc2/cn_012.wav",
        "text": "让俺再仔细多看两遍吧，嗯嗯。"
      }
    ],
    "精英化1": [
      {
        "url": "voice/char_1030_noirc2/cn_013.wav",
        "text": "俺能到这一步，可真是多亏了这一身厉害的装备，当然更重要的是俺身边的大家和博士一起给俺的帮助！"
      }
    ],
    "精英化2": [
      {
        "url": "voice/char_1030_noirc2/cn_014.wav",
        "text": "干员黑角，一定会作为大家的盾赴汤蹈火！嗯，作为大家的剑也行！"
      }
    ],
    "编入": [
      {
        "url": "voice/char_1030_noirc2/cn_017.wav",
        "text": "没问题，俺已经做好准备了。"
      }
    ],
    "任命队长": [
      {
        "url": "voice/char_1030_noirc2/cn_018.wav",
        "text": "需要俺来带领大家吗，夜刀也一起不？是不是让夜刀来更好。"
      }
    ],
    "行动出发": [
      {
        "url": "voice/char_1030_noirc2/cn_019.wav",
        "text": "任务出发前的大餐大家吃好了吗？出发！"
      }
    ],
    "行动开始": [
      {
        "url": "voice/char_1030_noirc2/cn_020.wav",
        "text": "任务开始，俺已确认目标位置！"
      }
    ],
    "选中": [
      {
        "url": "voice/char_1030_noirc2/cn_021.wav",
        "text": "需要俺去哪个区域？"
      },
      {
        "url": "voice/char_1030_noirc2/cn_022.wav",
        "text": "俺随时可以！"
      }
    ],
    "部署": [
      {
        "url": "voice/char_1030_noirc2/cn_023.wav",
        "text": "拔刀！"
      },
      {
        "url": "voice/char_1030_noirc2/cn_024.wav",
        "text": "这里吗！好！"
      }
    ],
    "技能": [
      {
        "url": "voice/char_1030_noirc2/cn_025.wav",
        "text": "哈！喝！"
      },
      {
        "url": "voice/char_1030_noirc2/cn_026.wav",
        "text": "俺来了！"
      },
      {
        "url": "voice/char_1030_noirc2/cn_027.wav",
        "text": "俺已经看穿了！"
      },
      {
        "url": "voice/char_1030_noirc2/cn_028.wav",
        "text": "这里有空隙！"
      }
    ],
    "高难胜利": [
      {
        "url": "voice/char_1030_noirc2/cn_029.wav",
        "text": "真是值得自豪的一场好战役，大家都辛苦了！"
      }
    ],
    "3星胜利": [
      {
        "url": "voice/char_1030_noirc2/cn_030.wav",
        "text": "任务完美完成！俺开始期待回到罗德岛的庆祝会了。"
      }
    ],
    "非3星胜利": [
      {
        "url": "voice/char_1030_noirc2/cn_031.wav",
        "text": "博士辛苦了，下次俺们一定能做得更好。"
      }
    ],
    "失败": [
      {
        "url": "voice/char_1030_noirc2/cn_032.wav",
        "text": "博士，有带上艾露猫们给的回家球吗？赶紧离开这里吧，俺之后也会跟上的！"
      }
    ],
    "进驻": [
      {
        "url": "voice/char_1030_noirc2/cn_033.wav",
        "text": "小心，小心，让俺先把刀收起来。"
      }
    ],
    "戳一下": [
      {
        "url": "voice/char_1030_noirc2/cn_034.wav",
        "text": "博士这是想让俺去哪里？"
      }
    ],
    "信赖触摸": [
      {
        "url": "voice/char_1030_noirc2/cn_036.wav",
        "text": "哈哈，博士愿意现在跟俺一起喝一杯吗？"
      }
    ],
    "标题": [
      {
        "url": "voice/char_1030_noirc2/cn_037.wav",
        "text": "明日方舟。"
      }
    ],
    "新年": [
      {
        "url": "voice/char_1030_noirc2/cn_038.wav",
        "text": "新年快乐博士，不来点蜂蜜酒怎么行，这些都是艾露猫们给的独特配方，快来试试啊！俺才刚喝一杯，已经开始感到精神振奋身体充满力量了！让俺们一起这样迎接新的一年吧！"
      }
    ],
    "问候": [
      {
        "url": "voice/char_1030_noirc2/cn_042.wav",
        "text": "博士，今天也注意身体啊！"
      }
    ]
  },
