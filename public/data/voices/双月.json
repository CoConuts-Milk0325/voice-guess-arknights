{
  "中文": {
    "登录": [
      {
        "url": "voice/char_4124_iana/cn_001.wav",
        "text": "怀疑我不在你面前？拜托，双子分身可不会说话。"
      }
    ],
    "交谈": [
      {
        "url": "voice/char_4124_iana/cn_002.wav",
        "text": "对我来说，一心多用从来都不是难事。"
      },
      {
        "url": "voice/char_4124_iana/cn_003.wav",
        "text": "多花些心思在情报上，有的仗可以打得更轻松。"
      },
      {
        "url": "voice/char_4124_iana/cn_004.wav",
        "text": "最好处理一下你热水壶底的水垢，不然咖啡的味道好不了。"
      }
    ],
    "晋升交谈": [
      {
        "url": "voice/char_4124_iana/cn_005.wav",
        "text": "亲眼所见并不一定可靠，借助设备才能发现隐藏的真相。"
      },
      {
        "url": "voice/char_4124_iana/cn_006.wav",
        "text": "异于常人的外表的确给我制造了一些困难，但也仅仅是“一些困难”而已。"
      }
    ],
    "信赖": [
      {
        "url": "voice/char_4124_iana/cn_007.wav",
        "text": "我听从你的指挥。"
      },
      {
        "url": "voice/char_4124_iana/cn_008.wav",
        "text": "我信任你的判断。"
      },
      {
        "url": "voice/char_4124_iana/cn_009.wav",
        "text": "我想我正在一场难忘的旅途之中，不知道最终会带什么样的纪念品回家。"
      }
    ],
    "闲置": [
      {
        "url": "voice/char_4124_iana/cn_010.wav",
        "text": "稍等，我马上回来。"
      }
    ],
    "报到": [
      {
        "url": "voice/char_4124_iana/cn_011.wav",
        "text": "彩虹小队成员，代号双月。我想我们有很多信息可以相互分享。"
      }
    ],
    "作战记录": [
      {
        "url": "voice/char_4124_iana/cn_012.wav",
        "text": "考虑过把录像做成三维的吗？"
      }
    ],
    "精英化1": [
      {
        "url": "voice/char_4124_iana/cn_013.wav",
        "text": "晋升？我可以访问更高权限的资料库了吗？"
      }
    ],
    "精英化2": [
      {
        "url": "voice/char_4124_iana/cn_014.wav",
        "text": "借此机会，我希望能踏足更多尚未探索过的角落。"
      }
    ],
    "编入": [
      {
        "url": "voice/char_4124_iana/cn_017.wav",
        "text": "友情提示，我的全息投影可挡不住子弹。"
      }
    ],
    "任命队长": [
      {
        "url": "voice/char_4124_iana/cn_018.wav",
        "text": "双子分身会指引方向。"
      }
    ],
    "行动出发": [
      {
        "url": "voice/char_4124_iana/cn_019.wav",
        "text": "怒斥光明的消逝。"
      }
    ],
    "行动开始": [
      {
        "url": "voice/char_4124_iana/cn_020.wav",
        "text": "发现目标。"
      }
    ],
    "选中": [
      {
        "url": "voice/char_4124_iana/cn_021.wav",
        "text": "我准备好了，你呢？"
      },
      {
        "url": "voice/char_4124_iana/cn_022.wav",
        "text": "正在收集情报。"
      }
    ],
    "部署": [
      {
        "url": "voice/char_4124_iana/cn_023.wav",
        "text": "掩护我。"
      },
      {
        "url": "voice/char_4124_iana/cn_024.wav",
        "text": "麦克风测试正常。"
      }
    ],
    "技能": [
      {
        "url": "voice/char_4124_iana/cn_025.wav",
        "text": "注意隐蔽！"
      },
      {
        "url": "voice/char_4124_iana/cn_026.wav",
        "text": "跟紧我！"
      },
      {
        "url": "voice/char_4124_iana/cn_027.wav",
        "text": "重新部署。"
      },
      {
        "url": "voice/char_4124_iana/cn_028.wav",
        "text": "敌人进入视野！"
      }
    ],
    "高难胜利": [
      {
        "url": "voice/char_4124_iana/cn_029.wav",
        "text": "如果知晓如何连接，所有系统都能互相补足。"
      }
    ],
    "3星胜利": [
      {
        "url": "voice/char_4124_iana/cn_030.wav",
        "text": "就该是这样。"
      }
    ],
    "非3星胜利": [
      {
        "url": "voice/char_4124_iana/cn_031.wav",
        "text": "你的斗志仍然旺盛，给他们看看你真正的能耐。"
      }
    ],
    "失败": [
      {
        "url": "voice/char_4124_iana/cn_032.wav",
        "text": "你的故事不会在这里结束。"
      }
    ],
    "进驻": [
      {
        "url": "voice/char_4124_iana/cn_033.wav",
        "text": "如果你非要这样的话。"
      }
    ],
    "戳一下": [
      {
        "url": "voice/char_4124_iana/cn_034.wav",
        "text": "拜托。"
      }
    ],
    "信赖触摸": [
      {
        "url": "voice/char_4124_iana/cn_036.wav",
        "text": "撑住，我来帮忙了。"
      }
    ],
    "标题": [
      {
        "url": "voice/char_4124_iana/cn_037.wav",
        "text": "明日方舟。"
      }
    ],
    "问候": [
      {
        "url": "voice/char_4124_iana/cn_042.wav",
        "text": "准备好行动了吗？"
      }
    ]
  },
