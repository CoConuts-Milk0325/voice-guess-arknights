{"中文":{"登录":[{"url":"voice_cn/char_4185_amoris/cn_001.wav","text":"啊，博士，有什么需要我来做的？"}],"交谈":[{"url":"voice_cn/char_4185_amoris/cn_002.wav","text":"呜哇，真厉害！在这里拍摄Vlog的话，播放量肯定能猛涨吧！不不不，我不会真的这样做的。"},{"url":"voice_cn/char_4185_amoris/cn_003.wav","text":"我现在有~一点~点忙呢，有什么事的话稍后再说吧~"},{"url":"voice_cn/char_4185_amoris/cn_004.wav","text":"罗德岛上也有形形色色的干员呢~大家都有着各自的理想和厉害的地方，真有意思，迫不及待想要跟大家多聊聊呢。"}],"晋升交谈":[{"url":"voice_cn/char_4185_amoris/cn_005.wav","text":"嗯？喵姆亲每天的自主练习？对啊，为了梦想付出一切努力，这不是理所当然的吗？"},{"url":"voice_cn/char_4185_amoris/cn_006.wav","text":"想让喵姆亲做更多的工作，需要另外支付报酬哟。呀，开玩笑的开玩笑的，为了报答博士和小阿米娅的信任，喵姆亲当然会努力工作啦~"}],"信赖":[{"url":"voice_cn/char_4185_amoris/cn_007.wav","text":"哦哦~罗德岛上有好多可爱的干员，真想拍一期给她们化妆的Vlog，肯定能收获大量的热度！"},{"url":"voice_cn/char_4185_amoris/cn_008.wav","text":"医疗部有好多孩子已经成了喵姆亲的粉丝~这样喵姆亲不去给他们一些回馈都不行了。"},{"url":"voice_cn/char_4185_amoris/cn_009.wav","text":"我最近也开始觉得，与其不择手段地朝着目标孤军奋战，偶尔稍稍绕绕远路也不是什么坏事。大概是受到了罗德岛的大家的影响吧？"}],"闲置":[{"url":"voice_cn/char_4185_amoris/cn_010.wav","text":"嗯，博士睡着了吗？机会难得，我来恶作剧了哦？开个玩笑~"}],"报到":[{"url":"voice_cn/char_4185_amoris/cn_011.wav","text":"你好~喵姆喵姆~喵姆亲来报到啦。请多指教~"}],"作战记录":[{"url":"voice_cn/char_4185_amoris/cn_012.wav","text":"太好了~♪喵姆亲还能继续进化~"}],"精英化1":[{"url":"voice_cn/char_4185_amoris/cn_013.wav","text":"怎么样，要变成喵姆亲的粉丝了吗？"}],"精英化2":[{"url":"voice_cn/char_4185_amoris/cn_014.wav","text":"嗯嗯，我表现得不错吧？多赞美一下我也没关系哦~"}],"编入":[{"url":"voice_cn/char_4185_amoris/cn_017.wav","text":"早上好~！"}],"任命队长":[{"url":"voice_cn/char_4185_amoris/cn_018.wav","text":"呃，要我来做指挥吗？祥子才更适合吧。"}],"行动出发":[{"url":"voice_cn/char_4185_amoris/cn_019.wav","text":"走了~"}],"行动开始":[{"url":"voice_cn/char_4185_amoris/cn_020.wav","text":"啊！有敌人！"}],"选中":[{"url":"voice_cn/char_4185_amoris/cn_021.wav","text":"我在这里哟~"},{"url":"voice_cn/char_4185_amoris/cn_022.wav","text":"叫我吗？"}],"部署":[{"url":"voice_cn/char_4185_amoris/cn_023.wav","text":"这里这里！"},{"url":"voice_cn/char_4185_amoris/cn_024.wav","text":"好的~"}],"技能":[{"url":"voice_cn/char_4185_amoris/cn_025.wav","text":"来见识一下我的实力吧！"},{"url":"voice_cn/char_4185_amoris/cn_026.wav","text":"嘿！"},{"url":"voice_cn/char_4185_amoris/cn_027.wav","text":"是时候火热起来了吧！"},{"url":"voice_cn/char_4185_amoris/cn_028.wav","text":"差得远了！"}],"高难胜利":[{"url":"voice_cn/char_4185_amoris/cn_029.wav","text":"哦哦~我们一起真不赖啊~！"}],"3星胜利":[{"url":"voice_cn/char_4185_amoris/cn_030.wav","text":"完美的胜利！接下来应该是庆功宴了吧！"}],"非3星胜利":[{"url":"voice_cn/char_4185_amoris/cn_031.wav","text":"唔......下次一定会更完美......"}],"失败":[{"url":"voice_cn/char_4185_amoris/cn_032.wav","text":"比起只是沮丧着什么都不做，还是想想问题出在哪里吧。"}],"进驻":[{"url":"voice_cn/char_4185_amoris/cn_033.wav","text":"呀~罗德岛居然有这么华丽的地方啊！"}],"戳一下":[{"url":"voice_cn/char_4185_amoris/cn_034.wav","text":"喵姆？"}],"信赖触摸":[{"url":"voice_cn/char_4185_amoris/cn_036.wav","text":"先别急嘛~"}],"标题":[{"url":"voice_cn/char_4185_amoris/cn_037.wav","text":"明日方舟。"}],"新年":[{"url":"voice_cn/char_4185_amoris/cn_038.wav","text":"新年快乐！对我来说，新的一年依然要向前迈进才行，博士也一样！"}],"问候":[{"url":"voice_cn/char_4185_amoris/cn_042.wav","text":"博士，辛苦了~！"}]},"日文":{"登录":[{"url":"voice/char_4185_amoris/cn_001.wav","text":"啊，博士，有什么需要我来做的？"}],"交谈":[{"url":"voice/char_4185_amoris/cn_002.wav","text":"呜哇，真厉害！在这里拍摄Vlog的话，播放量肯定能猛涨吧！不不不，我不会真的这样做的。"},{"url":"voice/char_4185_amoris/cn_003.wav","text":"我现在有~一点~点忙呢，有什么事的话稍后再说吧~"},{"url":"voice/char_4185_amoris/cn_004.wav","text":"罗德岛上也有形形色色的干员呢~大家都有着各自的理想和厉害的地方，真有意思，迫不及待想要跟大家多聊聊呢。"}],"晋升交谈":[{"url":"voice/char_4185_amoris/cn_005.wav","text":"嗯？喵姆亲每天的自主练习？对啊，为了梦想付出一切努力，这不是理所当然的吗？"},{"url":"voice/char_4185_amoris/cn_006.wav","text":"想让喵姆亲做更多的工作，需要另外支付报酬哟。呀，开玩笑的开玩笑的，为了报答博士和小阿米娅的信任，喵姆亲当然会努力工作啦~"}],"信赖":[{"url":"voice/char_4185_amoris/cn_007.wav","text":"哦哦~罗德岛上有好多可爱的干员，真想拍一期给她们化妆的Vlog，肯定能收获大量的热度！"},{"url":"voice/char_4185_amoris/cn_008.wav","text":"医疗部有好多孩子已经成了喵姆亲的粉丝~这样喵姆亲不去给他们一些回馈都不行了。"},{"url":"voice/char_4185_amoris/cn_009.wav","text":"我最近也开始觉得，与其不择手段地朝着目标孤军奋战，偶尔稍稍绕绕远路也不是什么坏事。大概是受到了罗德岛的大家的影响吧？"}],"闲置":[{"url":"voice/char_4185_amoris/cn_010.wav","text":"嗯，博士睡着了吗？机会难得，我来恶作剧了哦？开个玩笑~"}],"报到":[{"url":"voice/char_4185_amoris/cn_011.wav","text":"你好~喵