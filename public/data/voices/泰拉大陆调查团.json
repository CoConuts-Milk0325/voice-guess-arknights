{
  "中文": {
    "登录": [
      {
        "url": "voice/char_4077_palico/cn_001.wav",
        "text": "你们两个记好了喵，既然当了这个人的助理，就要打起精神来。要是有怪物突然冲进来，我们就赶紧把他扔到车上推走喵！"
      }
    ],
    "交谈": [
      {
        "url": "voice/char_4077_palico/cn_002.wav",
        "text": "最近研究的课题喵？《艾露与泰拉菲林的种族差异研究》，明明已经进行到一半了，但是突然又发现了名为阿斯兰的种族，前功尽弃了......泰拉人的种族真伤脑筋喵！"
      },
      {
        "url": "voice/char_4077_palico/cn_003.wav",
        "text": "阁下，出发狩猎前记得务必填饱肚子喵。精力满满地去战斗，说不定能爆发出超乎想象的能量......喵！"
      },
      {
        "url": "voice/char_4077_palico/cn_004.wav",
        "text": "敲，敲，没有燕雀石了喵......作为替代，岩蛛背上的石头，钳兽的壳......都加进去试试喵。"
      }
    ],
    "信赖": [
      {
        "url": "voice/char_4077_palico/cn_007.wav",
        "text": "每次见到山的时候，老夫总会想起一位故人喵。他拥有同样高大健壮的身材，自某一次武器折断后就决定不做随从了喵，但后来他似乎跟随调查团去新大陆当了料理长......真是世事难料喵。"
      },
      {
        "url": "voice/char_4077_palico/cn_008.wav",
        "text": "博士喵，看在我们交情的分上，就告诉你一个秘诀好了。要是在作战中受伤了，喝药的时候记得在身后点燃一个爆弹喵。你问为什么？这样就可以毫发无损地躲开敌人的偷袭了喵！"
      },
      {
        "url": "voice/char_4077_palico/cn_009.wav",
        "text": "泰拉的新素材喵，许多新的石头，喜欢喵......也许能做出和家乡冰窟里的那把大剑一样的武器喵！送给博士喵！"
      }
    ],
    "闲置": [
      {
        "url": "voice/char_4077_palico/cn_010.wav",
        "text": "喵喵，博士的房间里......好多奇怪的东西喵，趁博士在睡觉，想要搬走......小工匠！快住手喵！"
      }
    ],
    "报到": [
      {
        "url": "voice/char_4077_palico/cn_011.wav",
        "text": "听从阁下的召唤喵，艾露猫特别行动小组......最优秀的第一期泰拉大陆调查团来也！喵！不要踩我的脑袋喵！"
      }
    ],
    "作战记录": [
      {
        "url": "voice/char_4077_palico/cn_012.wav",
        "text": "小工匠，你怎么在这盒子里面了？动......竟然动起来了！怎么做到的喵？"
      }
    ],
    "编入": [
      {
        "url": "voice/char_4077_palico/cn_017.wav",
        "text": "我们都整装待发了喵！"
      }
    ],
    "任命队长": [
      {
        "url": "voice/char_4077_palico/cn_018.wav",
        "text": "意料之中，我最擅长的就是指挥了喵！"
      }
    ],
    "行动出发": [
      {
        "url": "voice/char_4077_palico/cn_019.wav",
        "text": "“猎人”们喵！充满活力地出发喵！"
      }
    ],
    "行动开始": [
      {
        "url": "voice/char_4077_palico/cn_020.wav",
        "text": "发现猎物了，阁下请小心喵。"
      }
    ],
    "选中": [
      {
        "url": "voice/char_4077_palico/cn_021.wav",
        "text": "听从阁下的派遣喵。"
      },
      {
        "url": "voice/char_4077_palico/cn_022.wav",
        "text": "喵！在喵！"
      }
    ],
    "部署": [
      {
        "url": "voice/char_4077_palico/cn_023.wav",
        "text": "你们两个！快上喵！"
      },
      {
        "url": "voice/char_4077_palico/cn_024.wav",
        "text": "太重了喵！"
      }
    ],
    "技能": [
      {
        "url": "voice/char_4077_palico/cn_025.wav",
        "text": "弱点在那里喵！"
      },
      {
        "url": "voice/char_4077_palico/cn_026.wav",
        "text": "露出破绽了喵！"
      },
      {
        "url": "voice/char_4077_palico/cn_027.wav",
        "text": "燃烧的狩猎之魂！"
      },
      {
        "url": "voice/char_4077_palico/cn_028.wav",
        "text": "最强的投掷技喵！"
      }
    ],
    "高难胜利": [
      {
        "url": "voice/char_4077_palico/cn_029.wav",
        "text": "危机......危机解除了喵？我能睁开眼睛了吗？"
      }
    ],
    "3星胜利": [
      {
        "url": "voice/char_4077_palico/cn_030.wav",
        "text": "阁下的指挥太精彩了，真是让老夫受益匪浅......喵。"
      }
    ],
    "非3星胜利": [
      {
        "url": "voice/char_4077_palico/cn_031.wav",
        "text": "一地的装备......捡，都捡走喵。"
      }
    ],
    "失败": [
      {
        "url": "voice/char_4077_palico/cn_032.wav",
        "text": "啊，要追上来了，快跑喵！"
      }
    ],
    "进驻": [
      {
        "url": "voice/char_4077_palico/cn_033.wav",
        "text": "拖，拖喵......小工匠，你怎么去哪里都带着一大堆材料喵？"
      }
    ],
    "戳一下": [
      {
        "url": "voice/char_4077_palico/cn_034.wav",
        "text": "喵~"
      }
    ],
    "信赖触摸": [
      {
        "url": "voice/char_4077_palico/cn_036.wav",
        "text": "你在干什么喵？喵......请再摸摸这里......啊，老夫也要被摸喵！"
      }
    ],
    "标题": [
      {
        "url": "voice/char_4077_palico/cn_037.wav",
        "text": "明日方舟。"
      }
    ],
    "问候": [
      {
        "url": "voice/char_4077_palico/cn_042.wav",
        "text": "喵，是博士！你好喵！"
      }
    ]
  },
