{"中文":{"登录":[{"url":"voice_cn/char_431_ashlok/cn_001.wav","text":"原来您也需要像大公司职员一样做文书工作，量还不小，需要帮忙么。"}],"交谈":[{"url":"voice_cn/char_431_ashlok/cn_002.wav","text":"想不到耀骑士也会接受雇佣，罗德岛真是家神奇的公司。"},{"url":"voice_cn/char_431_ashlok/cn_003.wav","text":"骑士或许能够跌倒后爬起来，感染者可没机会享受这种仁慈。"},{"url":"voice_cn/char_431_ashlok/cn_004.wav","text":"咳咳，武器好像出了些问题，咳咳咳，工坊哪里走？那里吗，好，谢谢，咳，咳咳。"}],"晋升交谈":[{"url":"voice_cn/char_431_ashlok/cn_005.wav","text":"如果骑士贵族能够切实履行他们的誓言和职责，感染者的处境本不应该这般窘迫。只是......贵族......卡西米尔人宁愿与大公司签安保合同，也不可能相信一位骑士贵族会去除暴安良。"},{"url":"voice_cn/char_431_ashlok/cn_006.wav","text":"他们都说家族是因为我的感染而没落，一切都是我的错。哼，这就是骑士贵族，一无是处，只知道欺侮弱者。"}],"信赖":[{"url":"voice_cn/char_431_ashlok/cn_007.wav","text":"查丝汀娜和我搭话喜欢加上封号......为什么，“灰毫”这个词对她来说很特别吗？"},{"url":"voice_cn/char_431_ashlok/cn_008.wav","text":"我和索娜是在团体混战赛上认识的，那是场苦战，但初次见面的我们很快就达成了共识一起应对其他选手，最后，她用剑取走我的积分，接着当场给我道了歉......于是我们就搭伙一起行动了。"},{"url":"voice_cn/char_431_ashlok/cn_009.wav","text":"故乡已经回不去了，我所能做的，只有和索娜她们一起探寻前路。呵......成为感染者骑士虽然不怎么好，但至少还有抗争的机会，未来再悲苦，总比现在要光明。"}],"闲置":[{"url":"voice_cn/char_431_ashlok/cn_010.wav","text":"适时休息吧，赛后恢复与日常训练同等重要。"}],"报到":[{"url":"voice_cn/char_431_ashlok/cn_011.wav","text":"红松骑士团，“灰毫”，格蕾纳蒂。感谢罗德岛的接纳。"}],"作战记录":[{"url":"voice_cn/char_431_ashlok/cn_012.wav","text":"协作突击？嗯，配合很默契。"}],"精英化1":[{"url":"voice_cn/char_431_ashlok/cn_013.wav","text":"这是资格认证奖章吗？哦......抱歉，我不太了解罗德岛的规定。谢谢。"}],"精英化2":[{"url":"voice_cn/char_431_ashlok/cn_014.wav","text":"“炮声轰鸣，胜利已在眼前。”"}],"编入":[{"url":"voice_cn/char_431_ashlok/cn_017.wav","text":"听从您的调遣。"}],"任命队长":[{"url":"voice_cn/char_431_ashlok/cn_018.wav","text":"需要我指挥？好。"}],"行动出发":[{"url":"voice_cn/char_431_ashlok/cn_019.wav","text":"愿各位凯旋。"}],"行动开始":[{"url":"voice_cn/char_431_ashlok/cn_020.wav","text":"准备好，对手接近了！"}],"选中":[{"url":"voice_cn/char_431_ashlok/cn_021.wav","text":"嗯。"},{"url":"voice_cn/char_431_ashlok/cn_022.wav","text":"下令吧。"}],"部署":[{"url":"voice_cn/char_431_ashlok/cn_023.wav","text":"战斗可没有点到为止的说法。"},{"url":"voice_cn/char_431_ashlok/cn_024.wav","text":"比赛开始了。"}],"技能":[{"url":"voice_cn/char_431_ashlok/cn_025.wav","text":"填弹！"},{"url":"voice_cn/char_431_ashlok/cn_026.wav","text":"炮击只是第一步。"},{"url":"voice_cn/char_431_ashlok/cn_027.wav","text":"防守，进攻！"},{"url":"voice_cn/char_431_ashlok/cn_028.wav","text":"我会赢下这一场！"}],"高难胜利":[{"url":"voice_cn/char_431_ashlok/cn_029.wav","text":"精彩，这就是指挥的艺术，受教了。"}],"3星胜利":[{"url":"voice_cn/char_431_ashlok/cn_030.wav","text":"看来您很擅长指挥团体战。"}],"非3星胜利":[{"url":"voice_cn/char_431_ashlok/cn_031.wav","text":"赛场上被多拿一分，胜算就少一分。"}],"失败":[{"url":"voice_cn/char_431_ashlok/cn_032.wav","text":"咳咳......是我的......错吗......"}],"进驻":[{"url":"voice_cn/char_431_ashlok/cn_033.wav","text":"还好装备不太占空间。"}],"戳一下":[{"url":"voice_cn/char_431_ashlok/cn_034.wav","text":"哼？"}],"信赖触摸":[{"url":"voice_cn/char_431_ashlok/cn_036.wav","text":"粉丝的礼物？送到您这里了？真抱歉，给您添麻烦了。"}],"标题":[{"url":"voice_cn/char_431_ashlok/cn_037.wav","text":"明日方舟。"}],"新年":[{"url":"voice_cn/char_431_ashlok/cn_038.wav","text":"索娜应该还在睡觉，艾沃娜在训练场，查丝汀娜在塔楼望风，至于我......我还没想好。博士，如果是普通的罗德岛干员，在这一天会做些什么呢？"}],"问候":[{"url":"voice_cn/char_431_ashlok/cn_042.wav","text":"今天有什么任务？"}]},"日文":{"登录":[{"url":"voice/char_431_ashlok/cn_001.wav","text":"原来您也需要像大公司职员一样做文书工作，量还不小，需要帮忙么。"}],"交谈":[{"url":"voice/char_431_ashlok/cn_002.wav","text":"想不到耀骑士也会接受雇佣，罗德岛真是家神奇的公司。"},{"url":"voice/char_431_ashlok/cn_003.wav","text":"骑士或许能够跌倒后爬起来，感染者可没机会享受这种仁慈。"},{"url":"voice/char_431_ashlok/cn_004.wav","text":"咳咳，武器好像出了些问题，咳咳咳，工坊哪里走？那里吗，好，谢谢，咳，咳咳。"}],"晋升交谈":[{"url":"voice/char_431_ashlok/cn_005.wav","text":"如果骑士贵族能够切实履行他们的誓言和职责，感染者的处境本不应该这般窘迫。只是......贵族......卡西米尔人宁愿与大公司签安保合同，也不可能相信一位骑士贵族会去除暴安良。"},{"url":"voice/char_431_ashlok/cn_006.wav","text":"他们都说家族是因为我的感染而没落，一切都是我的错。哼，这就是骑士贵族，一无是处，只知道欺侮弱者。"}],"信赖":[{"url":"voice/char_431_ashlok/cn_007.wav","text":"查丝汀娜和我搭话喜欢加上封号......为什么，“灰毫”这个词对她来说很特别吗？"},{"url":"voice/char_431_ashlok/cn_008.wav","text":"我和索娜是在团体混战赛上认识的，那是场苦战，但初次见面的我们很快就达成了共识一起应对其他选手，最后，她用剑取走我的积分，接着当场给我道了歉......于是我们就搭伙一起行动了。"},{"url":"voice/char_431_ashlok/cn_009.wav","text":"故乡已经回不去了，我所能做的，只有和索娜她们一起探寻前路。呵......成为感染者骑士虽